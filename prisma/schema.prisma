// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. ENUMS (Listas de valores predefinidos)
enum Role {
  EMPLOYEE
  ADMIN
}

enum TaskType {
  KYC
  WATCHLIST_REVIEW
  RISK_REVIEW
  RECORD_KEEPING
  ENHANCED_DUE_DILIGENCE
  ENHANCED_KYC
}

// 2. MODELO DE USUARIOS (Registro de Empleados y Administradores)
model User {
  id              String         @id @default(uuid())
  employeeId      String         @unique // ID o Cédula del empleado
  firstName       String
  lastName        String
  email           String         @unique
  birthDate       DateTime
  password        String         // Contraseña hasheada (con bcrypt, por ejemplo)
  role            Role           @default(EMPLOYEE) // Por defecto es empleado
  coachingCount   Int            @default(0)        // Cantidad de coachings acumulados (máx 3)
  suspendedUntil  DateTime?                         // Fecha hasta la cual está suspendido (1 día)
  isTaskActive    Boolean        @default(false)    // Si tiene un task activo en tiempo real
  currentTaskType String?                           // Tipo de caso activo actual
  taskStartedAt   DateTime?                         // Hora de inicio del task actual
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relaciones
  shifts                Shift[]
  tasks                 TaskMetric[]
  receivedGhostMessages GhostMessage[] @relation("ReceivedGhostMessages")
  sentGhostMessages     GhostMessage[] @relation("SentGhostMessages")
  agentCoachings        Coaching[]     @relation("AgentCoachings")
  givenCoachings        Coaching[]     @relation("GivenCoachings")
}

// 3. MODELO DE TURNOS (Para saber cuándo inicia y termina de trabajar)
model Shift {
  id          String    @id @default(uuid())
  userId      String
  startTime   DateTime  @default(now()) // Hora de inicio del turno
  endTime     DateTime?                 // Hora de fin (nulo hasta que el empleado cierre turno)
  
  user        User      @relation(fields: [userId], references: [id])
  tasks       TaskMetric[] // Tareas realizadas dentro de este turno específico
}

// 4. MODELO DE MÉTRICAS (Para medir el AHT y eficiencia de cada nota)
model TaskMetric {
  id              String    @id @default(uuid())
  userId          String
  shiftId         String?   // Opcional, pero útil para saber en qué turno se hizo
  taskType        TaskType  // Tipo de nota (KYC, Risk Review, etc.)
  
  startTime       DateTime  // Momento exacto en que abre el formulario de la nota
  endTime         DateTime  // Momento en que hace clic en "Copiar Nota"
  durationSeconds Int       // Tiempo total en segundos (Para sacar el AHT fácil)
  
  // Campos opcionales para auditoría y métricas de administradores
  decision        String?   // Approved, Denied, False Positive, True Positive, etc.
  country         String?   // País evaluado
  corridor        String?   // Corridor evaluado
  noteSummary     String?   // Contenido exacto de la nota generada
  metadata        String?   // JSON con atributos estructurados del formulario
  
  createdAt       DateTime  @default(now())

  // Relaciones
  user            User      @relation(fields: [userId], references: [id])
  shift           Shift?    @relation(fields: [shiftId], references: [id])
}

// 5. MODELO DE MENSAJES FANTASMA (Supervisión -> Agente)
model GhostMessage {
  id        String   @id @default(uuid())
  senderId  String
  agentId   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  sender    User     @relation("SentGhostMessages", fields: [senderId], references: [id])
  agent     User     @relation("ReceivedGhostMessages", fields: [agentId], references: [id])
}

// 6. MODELO DE COACHING (Control de demoras y AHT fuera de target)
model Coaching {
  id        String   @id @default(uuid())
  agentId   String
  adminId   String
  reason    String   // Razón de las demoras ingresada por el administrador
  ahtAtTime Int?     // AHT promedio en segundos al momento del coaching
  createdAt DateTime @default(now())

  agent     User     @relation("AgentCoachings", fields: [agentId], references: [id])
  admin     User     @relation("GivenCoachings", fields: [adminId], references: [id])
}